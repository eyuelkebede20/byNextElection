# MongoDB connection string
SECRET_MONGO_URI=

# 32+ random bytes used to derive per-locket AES keys.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# WARNING: if this changes, every previously sealed locket becomes permanently unreadable.
LOCKET_SECRET=

# Resend API key (https://resend.com) for the 5-year reminder email
RESEND_API_KEY=

# Verified Resend sender, e.g. "Till Next Election <hi@yourdomain.com>"
LOCKET_FROM_EMAIL=

# Shared secret guarding the reminder cron endpoint
CRON_SECRET=

# Public base URL used to build locket links inside emails, e.g. https://tillnextelection.app
PUBLIC_BASE_URL=http://localhost:5173
