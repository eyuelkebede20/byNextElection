# MongoDB connection string
SECRET_MONGO_URI=

# 32+ random bytes used to derive per-locket AES keys.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# WARNING: if this changes, every previously sealed locket becomes permanently unreadable.
LOCKET_SECRET=

# Telegram bot token from @BotFather (e.g. 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=

# Your bot's @username WITHOUT the @ (e.g. tillnextelection_bot).
# PUBLIC_ prefix exposes it to the browser for the "Connect Telegram" deep link.
PUBLIC_TELEGRAM_BOT_USERNAME=

# Random string you choose; set the same value when registering the webhook so
# we can verify incoming updates really come from Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Shared secret guarding the reminder cron endpoint
CRON_SECRET=

# Public base URL used to build locket links inside reminders.
# PUBLIC_ prefix makes it readable server-side via $env/dynamic/public.
PUBLIC_BASE_URL=http://localhost:5173
